{
  "permissions": {
    "allow": [
      "Bash(find:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/cloud-setup.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
