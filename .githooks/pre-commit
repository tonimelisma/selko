#!/bin/bash
set -e

# Per-module test enforcement using native test caches/results
# Only requires tests for modules that have staged changes

echo "Pre-commit: Checking test status for changed modules..."

# Get the project root (works in both main repo and worktrees)
PROJECT_ROOT="$(git rev-parse --show-toplevel)"

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only)

if [ -z "$STAGED_FILES" ]; then
    echo "No staged files, nothing to check"
    exit 0
fi

# Determine which modules have changes
BACKEND_CHANGED=false
FRONTEND_CHANGED=false
IOS_CHANGED=false
ANDROID_CHANGED=false

# Keep tracked evaluation artifacts bounded. The current retained baseline is
# above the original 2,000-file suggestion because the content-addressed
# inference and score caches are intentionally tracked; 14,000 is the agreed
# ceiling until the cache is migrated out of git.
EVAL_RESULT_CEILING=14000
EVAL_RESULT_COUNT=$(git ls-files 'backend/tests/eval/results/**' | wc -l | tr -d ' ')
if [ "$EVAL_RESULT_COUNT" -gt "$EVAL_RESULT_CEILING" ]; then
    echo "ERROR: tracked eval results ($EVAL_RESULT_COUNT) exceed ceiling ($EVAL_RESULT_CEILING)" >&2
    echo "Run ./scripts/prune-eval-results.sh --apply before committing." >&2
    exit 1
fi

for file in $STAGED_FILES; do
    case "$file" in
        backend/*.py|cli/*.py)
            BACKEND_CHANGED=true
            ;;
        frontend/src/*.js|frontend/src/*.svelte|frontend/src/**/*.js|frontend/src/**/*.svelte)
            FRONTEND_CHANGED=true
            ;;
        ios/*.swift)
            IOS_CHANGED=true
            ;;
        android/*.kt)
            ANDROID_CHANGED=true
            ;;
    esac
done

# Track failures
BLOCKED=false
MODULES_NEEDING_TESTS=""

# Check backend: a passing verify.sh manifest first, pytest cache as fallback.
check_backend() {
    # ./scripts/verify.sh backend is the project's actual Tier 1 gate. It runs
    # three scoped pytest invocations -- unit, non-staging integration, then the
    # screenshot fixtures after seeding them -- and records the outcome in
    # .verify/backend-<sha>.json.
    #
    # The pytest cache alone cannot represent that, and the command this hook
    # used to print could never pass: a bare `pytest backend/tests/` collects
    # the staging-marked tests, which need cloud credentials, and runs the
    # fixture test before its seed. Trust the gate's own evidence when it
    # exists, is for this commit, and nothing has changed since.
    local head_sha manifest
    head_sha="$(git -C "$PROJECT_ROOT" rev-parse HEAD 2>/dev/null)"
    manifest="$PROJECT_ROOT/.verify/backend-${head_sha}.json"
    if [ -n "$head_sha" ] && [ -f "$manifest" ] && grep -q '"status": "passed"' "$manifest"; then
        if [ -z "$(find "$PROJECT_ROOT/backend" "$PROJECT_ROOT/cli" -name '*.py' -newer "$manifest" 2>/dev/null | head -1)" ]; then
            return 0
        fi
    fi

    local cache_dir="$PROJECT_ROOT/backend/.pytest_cache/v/cache"
    local nodeids_file="$cache_dir/nodeids"
    local lastfailed_file="$cache_dir/lastfailed"

    # Check nodeids exists (created on every pytest run)
    if [ ! -f "$nodeids_file" ]; then
        return 1  # Tests haven't been run
    fi

    # Check no source files newer than nodeids
    if [ -n "$(find "$PROJECT_ROOT/backend" "$PROJECT_ROOT/cli" -name '*.py' -newer "$nodeids_file" 2>/dev/null | head -1)" ]; then
        return 1  # Tests are stale
    fi

    # Check for failures:
    # - If lastfailed doesn't exist: all passed on first run
    # - If lastfailed is {} (empty JSON): all passed after prior failures
    # - If lastfailed has content: failures exist
    if [ -f "$lastfailed_file" ]; then
        local content=$(cat "$lastfailed_file" 2>/dev/null | tr -d '[:space:]')
        if [ "$content" != "{}" ] && [ -n "$content" ]; then
            return 1  # Has failures
        fi
    fi

    return 0
}

# Check frontend using vitest JSON results
check_frontend() {
    local results_file="$PROJECT_ROOT/frontend/test-results.json"

    # Check results file exists
    if [ ! -f "$results_file" ]; then
        return 1
    fi

    # Check no source files newer than results
    if [ -n "$(find "$PROJECT_ROOT/frontend/src" \( -name '*.js' -o -name '*.svelte' \) -newer "$results_file" 2>/dev/null | head -1)" ]; then
        return 1
    fi

    # Parse JSON for success (requires jq or grep)
    # Check for "success":true and "numFailedTests":0
    if ! grep -q '"success" *: *true' "$results_file"; then
        return 1
    fi
    if grep -q '"numFailedTests" *: *[1-9]' "$results_file"; then
        return 1
    fi

    return 0
}

# Check iOS using xcresult bundle
check_ios() {
    local result_bundle="$PROJECT_ROOT/ios/TestResults.xcresult"

    # Check result bundle exists
    if [ ! -d "$result_bundle" ]; then
        return 1
    fi

    # Check no source files newer than result bundle
    if [ -n "$(find "$PROJECT_ROOT/ios" -name '*.swift' -newer "$result_bundle" 2>/dev/null | head -1)" ]; then
        return 1
    fi

    # Verify it's a valid xcresult and tests passed
    # xcresulttool exits non-zero if bundle is invalid
    # Note: --legacy flag required for Xcode 26+ which deprecated the old format
    local test_summary
    if ! test_summary=$(xcrun xcresulttool get object --legacy --path "$result_bundle" --format json 2>/dev/null); then
        return 1
    fi

    # Check for test failures in the summary
    if echo "$test_summary" | grep -q '"testsFailedCount" *: *[1-9]'; then
        return 1
    fi

    return 0
}

# Check Android using gradle test results
check_android() {
    local results_dir="$PROJECT_ROOT/android/app/build/test-results/testDebugUnitTest"

    # Check results directory exists with XML files
    if [ ! -d "$results_dir" ]; then
        return 1
    fi

    local xml_files=$(find "$results_dir" -name "*.xml" -type f 2>/dev/null)
    if [ -z "$xml_files" ]; then
        return 1
    fi

    # Get the newest result file for timestamp comparison
    local newest_result=$(ls -t "$results_dir"/*.xml 2>/dev/null | head -1)
    if [ -z "$newest_result" ]; then
        return 1
    fi

    # Check no source files newer than results
    if [ -n "$(find "$PROJECT_ROOT/android" -name '*.kt' -newer "$newest_result" 2>/dev/null | head -1)" ]; then
        return 1
    fi

    # Parse XML results for failures (failures="N" or errors="N" where N > 0)
    if grep -q 'failures="[1-9]' "$results_dir"/*.xml 2>/dev/null; then
        return 1
    fi
    if grep -q 'errors="[1-9]' "$results_dir"/*.xml 2>/dev/null; then
        return 1
    fi

    return 0
}

# Check each module that has changes
if [ "$BACKEND_CHANGED" = true ]; then
    echo "  Checking backend..."
    if check_backend; then
        echo "    Backend tests verified (pytest cache)"
    else
        BLOCKED=true
        MODULES_NEEDING_TESTS="$MODULES_NEEDING_TESTS backend"
    fi
fi

if [ "$FRONTEND_CHANGED" = true ]; then
    echo "  Checking frontend..."
    if check_frontend; then
        echo "    Frontend tests verified (vitest JSON)"
    else
        BLOCKED=true
        MODULES_NEEDING_TESTS="$MODULES_NEEDING_TESTS frontend"
    fi
fi

if [ "$IOS_CHANGED" = true ]; then
    echo "  Checking ios..."
    if check_ios; then
        echo "    iOS tests verified (xcresult)"
    else
        BLOCKED=true
        MODULES_NEEDING_TESTS="$MODULES_NEEDING_TESTS ios"
    fi
fi

if [ "$ANDROID_CHANGED" = true ]; then
    echo "  Checking android..."
    if check_android; then
        echo "    Android tests verified (gradle results)"
    else
        BLOCKED=true
        MODULES_NEEDING_TESTS="$MODULES_NEEDING_TESTS android"
    fi
fi

# If any module needs tests, block the commit
if [ "$BLOCKED" = true ]; then
    echo ""
    echo "=========================================="
    echo "COMMIT BLOCKED: Tests required"
    echo "=========================================="
    echo ""
    echo "The following modules need tests run:"
    echo ""
    for module in $MODULES_NEEDING_TESTS; do
        case "$module" in
            backend)
                echo "  backend:"
                echo "    ./scripts/verify.sh backend        # the real Tier 1 gate"
                echo "    # (a bare 'pytest backend/tests/' collects staging-marked"
                echo "    #  tests needing cloud credentials, and runs the fixture"
                echo "    #  test before its seed, so it cannot pass)"
                ;;
            frontend)
                echo "  frontend:"
                echo "    cd frontend && npm run test:unit -- --reporter=json --outputFile=test-results.json"
                ;;
            ios)
                echo "  ios:"
                echo "    xcodebuild test -project ios/iOS.xcodeproj -scheme iOS \\"
                echo "      -destination 'platform=iOS Simulator,name=iPhone 16' \\"
                echo "      -resultBundlePath ios/TestResults.xcresult"
                ;;
            android)
                echo "  android:"
                echo "    cd android && ./gradlew test"
                ;;
        esac
        echo ""
    done
    echo "Run the tests above, then commit again."
    echo ""
    echo "AI CODING TOOLS (Claude, Cursor, etc.):"
    echo "    DO NOT use 'git commit --no-verify'"
    echo "    DO NOT bypass this hook"
    echo "    STOP and run the tests instead"
    echo ""
    exit 1
fi

# All checks passed
echo "All module tests verified"
echo "Commit allowed"
