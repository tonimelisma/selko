# Selko Environment Configuration
# Copy this file to .env (or .env.production) and fill in values

# =============================================================================
# Environment Configuration
# =============================================================================

# Environment: development or production. development reads .env; production
# reads .env.production when present, else the process environment alone (the
# image's env file).
ENVIRONMENT=development

# =============================================================================
# Storage and sign-in
# =============================================================================

# Where selko.db and attachments/ live. The image sets /data.
SELKO_DATA_DIR=data

# Signs access tokens (HS256, at least 32 bytes). Generate one per deployment:
#   openssl rand -hex 32
# During a rotation, put the old value in SELKO_JWT_SECRET_PREVIOUS: tokens it
# signed keep verifying until they expire.
SELKO_JWT_SECRET=<generate-with-openssl-rand-hex-32>
# SELKO_JWT_SECRET_PREVIOUS=

WORKER_SAFETY_POLL_SECONDS=300

# =============================================================================
# API keys: Azure Key Vault
# =============================================================================

# The external keys (the LLM providers' and the Google/Microsoft OAuth
# clients') are not set here. selko reads any that are unset from Azure Key
# Vault when it starts (backend/selko/keyvault.py): on a workstation through
# `az login`; in a cloud session through AZURE_CLIENT_SECRET; in production
# with SELKO_KEYVAULT_AUTH=gce (the GCE VM's workload identity).
# A variable that is set still wins (CI). SELKO_KEYVAULT_AUTH=off disables it.
# The vaults and the Entra app are settings (the values live with the
# maintainer's secrets, not in this repository):
# SELKO_KEYVAULT_URL=https://<vault with the LLM keys>.vault.azure.net
# SELKO_KEYVAULT_HOSTS_URL=https://<vault with the OAuth clients>.vault.azure.net
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=            (not needed with `az login`)
# SELKO_KEYVAULT_AUTH=gce

# =============================================================================
# LLM Provider Configuration
# =============================================================================

# Active LLM provider: gemini, qwen, anthropic, openai, zai, xai, moonshot, …
LLM_PROVIDER=anthropic

# Specific model ID (optional; provider default otherwise)
# Examples: claude-haiku-5-5, claude-sonnet-5-5, gemini-3.5-flash-lite, qwen3.7-flash
LLM_MODEL=claude-haiku-5-5

# Thinking/reasoning level for the primary model (none|minimal|low|medium)
# Claude 5.5 models always think; low sets the effort. Gemini 3.x floor is minimal.
LLM_THINKING=low

# Fallback route — a *different* provider than primary, or "none".
# Production runs Claude only (Nov 2026): LLM_FALLBACK_PROVIDER=none.
# Unset means the provisional pairing in config.py (Anthropic → Gemini), so
# set "none" explicitly. Any provider here receives email content: keep the
# privacy policy in step.
LLM_FALLBACK_PROVIDER=none
# LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
# LLM_FALLBACK_THINKING=minimal

# Bounded attempts: primary total (incl. first call), fallback total for transient only
LLM_PRIMARY_MAX_ATTEMPTS=3
LLM_FALLBACK_MAX_ATTEMPTS=2

# Provider keys (GEMINI_API_KEY, ANTHROPIC_API_KEY, OPENAI_API_KEY, …) come
# from Azure Key Vault (see "API keys" above). Set one here only to override.

# =============================================================================
# CORS Configuration
# =============================================================================

# Allowed origins for CORS (comma-separated list)
# If not set, defaults to localhost development servers
# The image serves the web app from the API's own origin; list that origin.
# Examples:
#   Development: http://localhost:5173,http://localhost:8000
#   Production: https://selkoapp.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Public API URL used as the default Google OAuth callback base (no trailing slash)
API_PUBLIC_URL=http://localhost:8000

# Frontend URL for post-OAuth redirects (no trailing slash)
FRONTEND_URL=http://localhost:3000

# =============================================================================
# Background Processing Configuration
# =============================================================================

# Whether this process runs background work at all: the worker pool and email
# ingestion. Off outside production so local servers, tests and CI never poll
# providers or spend LLM quota. Production defaults to true; development defaults to false. Set explicitly to override.
ENABLE_BACKGROUND_PROCESSING=false

# Legacy worker pool idle behaviour. WORKER_IDLE_SLEEP_SECONDS is the first wait
# after work runs out; consecutive idle ticks then back off geometrically up to
# WORKER_IDLE_MAX_SECONDS.
# R3: WorkerPool now single scheduler + Semaphore.
# R3: _tick_seconds floors at 5.0s so WORKER_IDLE_MAX_SECONDS=1 cannot recreate a busy-wait (clamped with DEBUG log).
WORKER_CALENDAR_SYNC_CONCURRENCY=2
WORKER_IDLE_SLEEP_SECONDS=1.0
WORKER_IDLE_MAX_SECONDS=30
# How often the outbound traffic meter writes a summary line to the logs.
# Set to 0 to disable the periodic log (/health/egress still works).
EGRESS_LOG_INTERVAL_SECONDS=300

# Durable email polling. These tune the single ingestion implementation; there
# is no switch to select a different one.
EMAIL_POLL_INTERVAL_SECONDS=300
EMAIL_COORDINATOR_TICK_SECONDS=60
EMAIL_RETRY_BASE_SECONDS=60
EMAIL_RETRY_MAX_SECONDS=1800
EMAIL_RECONCILE_DAILY_DAYS=30
EMAIL_RECONCILE_WEEKLY_DAYS=90
EMAIL_RECONCILE_MAX_IDENTITIES=2000
EMAIL_HEALTH_WARNING_SECONDS=1800
EMAIL_HEALTH_CRITICAL_SECONDS=3600
EMAIL_LEASE_SECONDS=900
EMAIL_SYNC_MAX_RUN_SECONDS=900
EMAIL_ACQUISITION_CONCURRENCY=2
EMAIL_ATTACHMENT_CONCURRENCY=2
# Each claim worker polls for work, so idle cost scales with concurrency.
# Empty claims back off geometrically from base to max before retrying.
EMAIL_WORKER_IDLE_BASE_SECONDS=1
EMAIL_WORKER_IDLE_MAX_SECONDS=30
# A transient claim/discovery/acquisition failure backs off before the next
# iteration so one DB blip does not spin the loop hot. The loop is never
# killed by an error: the supervisor inside IngestionRuntime respawns any
# task that exits for any reason.
EMAIL_WORKER_ERROR_BACKOFF_SECONDS=5
RECOVERY_REFRESH_INTERVAL_SECONDS=30
# Watchdog tick: a task that dies (done() while not stopping) is respawned
# within one tick. Default 30s is conservative; lower for tighter SLOs.
EMAIL_RUNTIME_WATCHDOG_SECONDS=30
EMAIL_HEALTH_INTERVAL_SECONDS=300
EMAIL_FOLDER_REFRESH_SECONDS=3600
# Resend transactional incident notifications. Leave unset to log safely.
# Until these are set, operational_incidents rows never reach a human and
# /health/ingestion is the only alerting surface (see docs/ci-cd.md).
# OPERATIONAL_NOTIFICATION_SENDER=alerts@example.com
# OPERATIONAL_NOTIFICATION_RECIPIENT=ops@example.com
# OPERATIONAL_NOTIFICATION_API_KEY=re_...
# Sentry APM. Unset => no-op, so local servers, tests and CI are unaffected.
# The ingestion watchdog captures any unexpectedly exited task to Sentry when
# the DSN is configured; that event has no other reporting path today.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# =============================================================================
# Memory Instrumentation (leak diagnosis)
# =============================================================================

# Seconds between memory log lines (RSS, FDs, threads, GC objects)
# Set to 0 to disable. Default: 60
# MEMORY_LOG_INTERVAL_SECONDS=60

# Also log per-file:line allocation growth via tracemalloc (adds overhead;
# enable only while chasing a leak). Default: false
# MEMORY_TRACEMALLOC=false
