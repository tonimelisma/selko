# Selko Environment Configuration
# Copy this file to .env, .env.test, or .env.production and fill in values

# =============================================================================
# Environment Configuration
# =============================================================================

# Environment: development, staging, or production
# This variable determines which .env file to load:
#   development -> .env (local Supabase via Docker)
#   staging     -> .env.test (cloud Supabase staging)
#   production  -> .env.production (cloud Supabase production)
ENVIRONMENT=development

# =============================================================================
# Supabase Configuration
# =============================================================================

# Project URL (local: http://localhost:54321, cloud: https://<ref>.supabase.co)
SUPABASE_URL=http://localhost:54321

# Publishable key (safe for client-side, supports key rotation)
# Find in: Dashboard > Settings > API > Publishable key
# Format: sb_publishable_XXXXXXX
SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>

# Service role key (server-side only, has admin access)
# Find in: Dashboard > Settings > API > Secret keys
# Format: sb_secret_XXXXXXX
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Direct PostgreSQL connection (for migrations and admin tasks)
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Project reference ID (for CLI operations)
SUPABASE_PROJECT_REF=<your-project-ref>

# Database password (for cloud projects)
SUPABASE_DB_PASSWORD=<your-db-password>

# JWT Secret for API authentication (Dashboard > Settings > API > JWT Settings)
SUPABASE_JWT_SECRET=<your-jwt-secret>

# =============================================================================
# Google OAuth Configuration
# =============================================================================

# OAuth 2.0 Client ID from Google Cloud Console
GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com

# OAuth 2.0 Client Secret
GOOGLE_CLIENT_SECRET=<your-client-secret>

# Microsoft Graph / Outlook OAuth (Azure Entra app registration)
MICROSOFT_CLIENT_ID=<your-microsoft-app-id>
MICROSOFT_CLIENT_SECRET=<your-microsoft-client-secret>

# =============================================================================
# LLM Provider Configuration
# =============================================================================

# Active LLM provider: gemini, qwen, anthropic, openai, zai, xai, moonshot, …
LLM_PROVIDER=gemini

# Specific model ID (optional; gemini default is gemini-3.5-flash-lite)
# Examples: gemini-3.5-flash-lite, qwen3.7-flash, claude-sonnet-5, gpt-5.6-terra
LLM_MODEL=gemini-3.5-flash-lite

# Thinking/reasoning level for the primary model (none|minimal|low|medium)
# Gemini 3.x preferred floor is minimal.
LLM_THINKING=minimal

# Fallback route — must be a *different* provider than primary.
# Eval-backed pairing (Jul 2026): gemini-3.5-flash-lite → qwen3.7-flash
LLM_FALLBACK_PROVIDER=qwen
LLM_FALLBACK_MODEL=qwen3.7-flash
LLM_FALLBACK_THINKING=low

# Bounded attempts: primary total (incl. first call), fallback total for transient only
LLM_PRIMARY_MAX_ATTEMPTS=3
LLM_FALLBACK_MAX_ATTEMPTS=2

# --- Gemini (Google) ---
# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=<your-gemini-api-key>

# --- Moonshot / Kimi (vision, OpenAI-compatible; models deferred) ---
# MOONSHOT_API_KEY=<your-moonshot-api-key>

# --- Z.AI / Zhipu (vision + text, OpenAI-compatible) ---
# ZAI_API_KEY=<your-zai-api-key>
# ZHIPU_API_KEY=<alias-for-zai-or-zhipu-console-key>

# --- DeepSeek (text-only, OpenAI-compatible; models deferred) ---
# DEEPSEEK_API_KEY=<your-deepseek-api-key>

# --- Alibaba / Qwen (vision + text, OpenAI-compatible) ---
# ALIBABA_API_KEY=<your-alibaba-api-key>

# --- MiniMax (text-only, OpenAI-compatible; models deferred) ---
# MINIMAX_API_KEY=<your-minimax-api-key>

# --- OpenAI ---
# OPENAI_API_KEY=<your-openai-api-key>

# --- Anthropic / Claude ---
# ANTHROPIC_API_KEY=<your-anthropic-api-key>

# --- xAI / Grok ---
# XAI_API_KEY=<your-xai-api-key>

# --- Meta Model API / Muse Spark ---
# Accepts any of: META_API_KEY, META_MODEL_API_KEY, or MODEL_API_KEY
# META_MODEL_API_KEY=<your-meta-model-api-key>
# META_API_KEY=<your-meta-model-api-key>
# MODEL_API_KEY=<your-meta-model-api-key>

# --- Thinking Machines / Tinker (Inkling) ---
# TINKER_API_KEY=<your-tinker-api-key>

# =============================================================================
# Test User Configuration (for CLI tools)
# =============================================================================

# Test user credentials for CLI authentication
# Create user via: uv run python -m cli.cli_user create --email <email> --password <password>
TEST_USER_EMAIL=test@selko.local
TEST_USER_PASSWORD=<your-test-password>

# =============================================================================
# CORS Configuration
# =============================================================================

# Allowed origins for CORS (comma-separated list)
# If not set, defaults to localhost development servers
# Examples:
#   Development: http://localhost:3000,http://localhost:5173
#   Staging: https://selko-web-staging.onrender.com
#   Production: https://selkoapp.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Public API URL used as the default Google OAuth callback base (no trailing slash)
# Staging: https://selko.onrender.com
# Production: https://api.selkoapp.com
API_PUBLIC_URL=http://localhost:8000

# Frontend URL for post-OAuth redirects (no trailing slash)
# Staging: https://selko-web-staging.onrender.com
# Production: https://selkoapp.com
FRONTEND_URL=http://localhost:3000

# =============================================================================
# Background Processing Configuration
# =============================================================================

# Whether this process runs background work at all: the worker pool and email
# ingestion. Off outside production so local servers, tests and CI never poll
# providers or spend LLM quota. Production defaults to true; development and
# staging default to false. Set explicitly to override.
ENABLE_BACKGROUND_PROCESSING=false

# Durable email polling. These tune the single ingestion implementation; there
# is no switch to select a different one.
EMAIL_POLL_INTERVAL_SECONDS=300
EMAIL_COORDINATOR_TICK_SECONDS=60
EMAIL_RETRY_BASE_SECONDS=60
EMAIL_RETRY_MAX_SECONDS=1800
EMAIL_RECONCILE_DAILY_DAYS=30
EMAIL_RECONCILE_WEEKLY_DAYS=90
EMAIL_HEALTH_WARNING_SECONDS=1800
EMAIL_HEALTH_CRITICAL_SECONDS=3600
EMAIL_LEASE_SECONDS=900
EMAIL_SYNC_MAX_RUN_SECONDS=900
EMAIL_ACQUISITION_CONCURRENCY=2
EMAIL_ATTACHMENT_CONCURRENCY=2
# Each claim worker polls for work, so idle cost scales with concurrency.
# Empty claims back off geometrically from base to max before retrying.
EMAIL_WORKER_IDLE_BASE_SECONDS=1
EMAIL_WORKER_IDLE_MAX_SECONDS=30
# A transient claim/discovery/acquisition failure backs off before the next
# iteration so one DB blip does not spin the loop hot. The loop is never
# killed by an error: the supervisor inside IngestionRuntime respawns any
# task that exits for any reason.
EMAIL_WORKER_ERROR_BACKOFF_SECONDS=5
# Watchdog tick: a task that dies (done() while not stopping) is respawned
# within one tick. Default 30s is conservative; lower for tighter SLOs.
EMAIL_RUNTIME_WATCHDOG_SECONDS=30
EMAIL_HEALTH_INTERVAL_SECONDS=300
# Resend transactional incident notifications. Leave unset to log safely.
# Until these are set, operational_incidents rows never reach a human and
# /health/ingestion is the only alerting surface (see docs/ci-cd.md).
# OPERATIONAL_NOTIFICATION_SENDER=alerts@example.com
# OPERATIONAL_NOTIFICATION_RECIPIENT=ops@example.com
# OPERATIONAL_NOTIFICATION_API_KEY=re_...
# Sentry APM. Unset => no-op, so local servers, tests and CI are unaffected.
# The ingestion watchdog captures any unexpectedly exited task to Sentry when
# the DSN is configured; that event has no other reporting path today.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# =============================================================================
# Memory Instrumentation (leak diagnosis)
# =============================================================================

# Seconds between memory log lines (RSS, FDs, threads, GC objects)
# Set to 0 to disable. Default: 60
# MEMORY_LOG_INTERVAL_SECONDS=60

# Also log per-file:line allocation growth via tracemalloc (adds overhead;
# enable only while chasing a leak). Default: false
# MEMORY_TRACEMALLOC=false
