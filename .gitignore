# macOS
.DS_Store

# Xcode
xcuserdata/
*.xcuserstate

# Environment files
.env
.env.local
.env.test
.env.production
!.env.example

# Supabase
supabase/.env
.mcp.json

# CLI sensitive data
cli/credentials.json
cli/token.json

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/

# Claude - track hooks and shared settings, ignore personal/local config
.claude/settings.local.json
.claude/mcp.json

.cursor/

# Frontend (SvelteKit)
frontend/node_modules/
frontend/.svelte-kit/
frontend/build/
frontend/coverage/

# Test results (generated, used by pre-commit hook)
ios/TestResults.xcresult/
frontend/test-results.json
test-results/
.verify/

# MCP tool artifacts
.playwright-mcp/
.xcodebuildmcp/

# Agent scratch plans. Durable plans belong in docs/specs/ where they are
# indexed and status-checked; an untracked plan goes stale invisibly (the
# 2026-08-12 acquisition plan still said "no code was edited" after it shipped).
.agents/
